# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API.
# The anon/publishable key is safe to ship to the browser; access is enforced by
# the row-level-security policies in supabase/setup.sql.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
